  "types": [
    {
      "name": "Escrow",
      "docs": [
        "Program-owned SOL escrow for one task. Its PDA can only be debited by this program."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "task",
            "type": "pubkey"
          }
        ]
      }
    },
    {
      "name": "Task",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "creator",
            "docs": [
              "Creator of the bounty task"
            ],
            "type": "pubkey"
          },
          {
            "name": "worker",
            "docs": [
              "Assigned worker / contributor"
            ],
            "type": {
              "option": "pubkey"
            }
          },
          {
            "name": "reward_lamports",
            "docs": [
              "Reward in lamports held in escrow"
            ],
            "type": "u64"
          },
          {
            "name": "task_id",
            "docs": [
              "Unique numeric identifier for the creator's task"
            ],
            "type": "u64"
          },
          {
            "name": "deadline",
            "docs": [
              "Unix timestamp deadline"
            ],
            "type": "i64"
          },
          {
            "name": "status",
            "docs": [
              "Current lifecycle status"
            ],
            "type": {
              "defined": {
                "name": "TaskStatus"
              }
            }
          },
          {
            "name": "category",
            "docs": [
              "Category ID or identifier (e.g. dev, design, audit)"
            ],
            "type": "u8"
          },
          {
            "name": "title",
            "docs": [
              "Brief title (up to 80 chars)"
            ],
            "type": "string"
          },
          {
            "name": "spec_hash",
            "docs": [
              "SHA-256 hash or identifier of detailed description / specification"
            ],
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "submission_data",
            "docs": [
              "Deliverable proof URL, PR, or IPFS CID (up to 256 chars)"
            ],
            "type": "string"
          },
          {
            "name": "submitted_at",
            "docs": [
              "Timestamp when work was submitted"
            ],
            "type": "i64"
          },
          {
            "name": "completed_at",
            "docs": [
              "Timestamp when task was completed/approved"
            ],
            "type": "i64"
          },
          {
            "name": "bump",
            "docs": [
              "PDA bump"
            ],
            "type": "u8"
          },
          {
            "name": "escrow_bump",
            "docs": [
              "Escrow PDA bump"
            ],
            "type": "u8"
          }
        ]
      }
    },
